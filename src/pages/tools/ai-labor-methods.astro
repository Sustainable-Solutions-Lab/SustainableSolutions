---
import BaseLayout from '../../layouts/BaseLayout.astro';
import tools from '../../data/tools.json';
import type { Tool } from '../../lib/types';

// Companion methods page for the AI and labor tool (/tools/ai-labor): the
// model schematic, the force identity, what each input is and where its value
// comes from, the scenario grid behind the ranges, the Engel explainer, and
// the caveats. noindex matches the tool itself — both go public when the
// Tools sheet lists the tool.
const tool = (tools as Tool[]).find((t) => t.slug === 'ai-labor') ?? null;

const inputs = [
  {
    sym: 'ε', name: 'Income elasticity of demand',
    what: 'How strongly demand for the industry’s output responds to income: each 1% of income growth moves the quantity demanded by about ε%.',
    source: 'Measured per industry: 66 years (1959–2025) of US personal consumption (BEA PCE) regressed on real disposable income per person, bridged from ≈200 spending categories to BEA’s detail industries. Two specifications (levels and price-controlled) bound it in the scenario grid.',
  },
  {
    sym: 'ρ', name: 'Human-attention shield',
    what: 'The share of an industry’s spending growth that buys more human attention per unit rather than more units: more nurse hours per bed-day, more teachers per pupil. That labor stays human whatever AI can do.',
    source: 'Measured for 21 industries from natural-unit series (inpatient days, enrollment, consultations, passengers and others) and assigned by demand class elsewhere; 80% of it (50–100% in the scenario grid) is treated as embodied human attention.',
  },
  {
    sym: 'ℓ', name: 'Labor cost share',
    what: 'Compensation as a share of the industry’s output value; it bounds how much automation can cut the price.',
    source: 'BEA 2017 detail benchmark input–output accounts (compensation of employees ÷ gross output).',
  },
  {
    sym: 'θ', name: 'Task mix (physical / analytic / creative)',
    what: 'How the industry’s wage bill divides across task types. Physical tasks need a body; analytic tasks are compute-like cognition; creative tasks are novel combination and judgment.',
    source: 'Occupation staffing (BLS OEWS, May 2024) crossed with task content (O*NET 30.3): teleworkability separates physical from cognitive work, and analytic and creative composites split the rest.',
  },
  {
    sym: 'g', name: 'AI reach by task type',
    what: 'The share of each task type AI can perform at full progress. An industry’s AI exposure, the automated share of its tasks, is its task mix weighted by these reaches.',
    source: 'Scenarios, not measurements: central 25% physical, 95% analytic, 60% creative; the grid spans 0–60%, 70–100% and 30–90%.',
  },
  {
    sym: 'χ', name: 'Workers’ share of capital income',
    what: 'Who receives the returns on the capital AI runs on. It changes how well off workers are far more than which industries grow.',
    source: 'Three worlds in the scenario grid: concentrated (0), today-like (0.3) and broad (all of it).',
  },
];
---

<BaseLayout
  title="AI and labor — methods"
  description="Model schematic, equations, and data provenance for the AI and labor tool."
  noindex={tool?.unlisted ?? true}
>
  <article class="wrap">
    <header>
      <p class="eyebrow">Model schematic · <a href="/tools/ai-labor">AI and labor</a></p>
      <h1>What the AI and labor tool rests on</h1>
      <p class="lede">
        Every chart in the tool reports one model at full AI progress: an 84-industry general
        equilibrium of the US economy in which one budget and one labor market discipline every
        industry at once. It asks which industries' jobs AI shrinks or grows, what happens to pay in
        each, and why. The industry characteristics that decide the answer are measured wherever
        the data allows; AI capability, growth and ownership are scenarios.
      </p>
    </header>

    <section>
      <h2>The model in one picture</h2>
      <figure>
        <svg viewBox="0 0 760 300" role="img" aria-label="Schematic: measured industry characteristics and scenario assumptions feed an 84-industry general equilibrium, which yields each industry's change in jobs and average wage and the forces behind them.">
          <defs>
            <marker id="arr" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0,0.5 L7.5,4 L0,7.5" fill="none" stroke="var(--ink-3)" stroke-width="1.3" />
            </marker>
          </defs>
          <style>
            .box { fill: var(--paper-2); stroke: var(--rule-strong); }
            .out { fill: var(--paper-2); stroke: var(--ink); stroke-width: 1.5; }
            .t { font-family: var(--font-sans); font-size: 12.5px; fill: var(--ink); }
            .s { font-family: var(--font-mono); font-size: 10.5px; fill: var(--ink-3); }
            .e { font-family: var(--font-mono); font-size: 10.5px; fill: var(--cardinal); }
            .f { fill: none; stroke: var(--ink-3); stroke-width: 1.1; marker-end: url(#arr); }
          </style>

          <rect class="box" x="12" y="24" width="210" height="112" rx="4" />
          <text class="t" x="117" y="46" text-anchor="middle">Measured, per industry</text>
          <text class="s" x="117" y="68" text-anchor="middle">ε income elasticity</text>
          <text class="s" x="117" y="84" text-anchor="middle">ρ human-attention shield</text>
          <text class="s" x="117" y="100" text-anchor="middle">ℓ labor cost share</text>
          <text class="s" x="117" y="116" text-anchor="middle">θ task mix</text>

          <rect class="box" x="12" y="160" width="210" height="112" rx="4" />
          <text class="t" x="117" y="182" text-anchor="middle">Scenarios (a full grid)</text>
          <text class="s" x="117" y="204" text-anchor="middle">g AI reach by task type</text>
          <text class="s" x="117" y="220" text-anchor="middle">productivity growth</text>
          <text class="s" x="117" y="236" text-anchor="middle">capital supply · ownership χ</text>
          <text class="e" x="117" y="256" text-anchor="middle">648 economies × 3 worlds</text>

          <rect class="box" x="280" y="92" width="210" height="112" rx="4" />
          <text class="t" x="385" y="116" text-anchor="middle" style="font-weight:600">General equilibrium</text>
          <text class="s" x="385" y="138" text-anchor="middle">84 industries + rest of economy</text>
          <text class="s" x="385" y="154" text-anchor="middle">one budget, nonhomothetic demand</text>
          <text class="s" x="385" y="170" text-anchor="middle">AI takes exposed tasks to capital</text>
          <text class="s" x="385" y="186" text-anchor="middle">workers move imperfectly</text>

          <rect class="out" x="548" y="40" width="200" height="64" rx="4" />
          <text class="t" x="648" y="64" text-anchor="middle" style="font-weight:600">Jobs by industry</text>
          <text class="s" x="648" y="82" text-anchor="middle">share of a fixed workforce</text>

          <rect class="out" x="548" y="118" width="200" height="64" rx="4" />
          <text class="t" x="648" y="142" text-anchor="middle" style="font-weight:600">Average wage by industry</text>
          <text class="s" x="648" y="160" text-anchor="middle">real, mobility elasticity 2</text>

          <rect class="out" x="548" y="196" width="200" height="64" rx="4" />
          <text class="t" x="648" y="220" text-anchor="middle" style="font-weight:600">The forces behind each</text>
          <text class="s" x="648" y="238" text-anchor="middle">exact decomposition</text>

          <path class="f" d="M222,80 C 250,90 256,120 276,132" />
          <path class="f" d="M222,216 C 250,206 256,176 276,166" />
          <path class="f" d="M490,130 C 512,110 520,80 544,74" />
          <path class="f" d="M490,148 L 544,150" />
          <path class="f" d="M490,166 C 512,186 520,220 544,226" />
        </svg>
        <figcaption>
          Measured industry characteristics and scenario assumptions feed one general equilibrium,
          solved at full AI progress for every combination of scenarios. Its outputs are each
          industry's change in jobs and in average real wage, and the forces behind the jobs change.
        </figcaption>
      </figure>
    </section>

    <section>
      <h2>The forces identity</h2>
      <p>With GDP as the numeraire, an industry's employment is labor per unit of output times its spending share divided by its price, so its log change in jobs splits exactly:</p>
      <pre>ln J = ln(labor per unit) + ln(spending share) − ln(price)

ln(labor per unit) = ln(1 − A)          AI takes over tasks
                   + ln(h / (1 − A))    human-attention shield
                   + rest               labor-capital mix

A = θ_P g_P + θ_A g_A + θ_C g_C        (full progress)
h = ρψ + (1 − ρψ)(1 − A)

workforce share of industry s ∝ base share × w_s^2</pre>
      <p>
        The AI term is split among physical, analytic and creative tasks in proportion to each
        type's share of the automated tasks (θ_k g_k / A), so the three parts add up to the whole.
        Cheaper output is −ln(price) and spending shifts are ln(spending share).
      </p>
    </section>

    <section>
      <h2>What each input is, and where its value comes from</h2>
      <dl>
        {inputs.map((l) => (
          <div class="lever">
            <dt><span class="sym">{l.sym}</span> {l.name}</dt>
            <dd>
              <p>{l.what}</p>
              <p class="src">{l.source}</p>
            </dd>
          </div>
        ))}
      </dl>
    </section>

    <section>
      <h2>Scenarios and ranges</h2>
      <p>
        The model is solved on a full grid of its uncertain assumptions: AI reach into physical (3
        levels), analytic (3) and creative (3) tasks, capital supply (3), the human share of
        attention spending (2), productivity growth (2) and the demand estimate (2), 648
        economies, each in three ownership worlds, 1,944 outcomes per industry. Without additional
        productivity growth, full AI progress raises real output about 1.2-fold; the growth case
        raises it about 3.5-fold. Ranges in the tool are the 5th to 95th percentile of an
        industry's outcomes in the chosen growth case (972 for jobs; 324 for wages, which hold
        ownership at today-like levels). An industry "loses" or "gains" if it does so in at least
        90% of all outcomes, and the decision bar splits its uncertainty among capability, demand
        and ownership by a first-order variance decomposition over the grid.
      </p>
    </section>

    <section>
      <h2>Engel parameters, briefly</h2>
      <p>
        An Engel curve traces how spending on a good changes as income rises, named for Ernst
        Engel's 1857 observation that food's share of the household budget falls as households get
        richer. Its slope, the income elasticity ε, is the demand-ceiling idea in one number: when ε
        has fallen to zero, more income buys no more of the good, and productivity growth in that
        industry can only cut jobs. Across US industries the systematic pattern is that physical
        goods sit low (food at home ≈ 0.5) while human-time services and open-ended categories sit
        high (≈ 2–3). In the model, saturation matters most when automation also makes households
        much richer, which is why the growth case brings it to the fore.
      </p>
    </section>

    <section>
      <h2>Caveats</h2>
      <ul>
        <li>Scenario analysis, not a forecast: results are conditional on assumptions whose future values nobody knows.</li>
        <li>Total employment is fixed: industry changes are shifts in shares of jobs, not unemployment; transition frictions, wage floors and exit from the labor force are not modeled.</li>
        <li>Measured elasticities are long-run co-movements, extrapolated out of sample.</li>
        <li>Task shares divide the wage bill, which proxies output composition imperfectly.</li>
        <li>Wage results rest on an assumed mobility between industries rather than measured worker flows.</li>
      </ul>
      <p class="src">
        Data: BEA 2017 detail benchmark input–output accounts; BLS QCEW 2025 employment; BLS OEWS
        May 2024 staffing; O*NET 30.3 task content; Dingel–Neiman (2020) teleworkability; BEA PCE
        and real disposable income, 1959–2025. The research repository (code, tests and the
        general-equilibrium model) is private while the paper is in preparation. Aggregate
        framework: <a href="https://www.brookings.edu/articles/artificial-intelligence-saturation-and-the-future-of-work/">Kording &amp; Marinescu (2025)</a>.
      </p>
    </section>
  </article>
</BaseLayout>

<style>
  .wrap {
    max-width: 760px;
    margin: 0 auto;
    padding: 40px clamp(16px, 4vw, 32px) 72px;
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin: 0 0 8px;
  }
  h1 {
    font-family: var(--font-serif);
    font-size: clamp(28px, 4vw, 38px);
    font-weight: 600;
    line-height: 1.12;
    margin: 0 0 12px;
  }
  .lede { color: var(--ink-2); font-size: 17px; line-height: 1.55; margin: 0; }
  h2 {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 600;
    line-height: 1.28;
    margin: 0 0 10px;
    padding-top: 18px;
    border-top: 1px solid var(--rule);
  }
  p, li { color: var(--ink-2); font-size: 15px; line-height: 1.6; }
  p { margin: 0 0 10px; }
  figure { margin: 0; }
  figure svg { display: block; width: 100%; height: auto; }
  figcaption {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 13.5px;
    color: var(--ink-3);
    line-height: 1.45;
    margin-top: 8px;
  }
  pre {
    font-family: var(--font-mono);
    font-size: clamp(11px, 2.9vw, 12.5px);
    line-height: 1.7;
    color: var(--ink);
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 14px 16px;
    white-space: pre-wrap;
  }
  dl { margin: 0; display: flex; flex-direction: column; gap: 16px; }
  .lever dt {
    font-weight: 600;
    color: var(--ink);
    font-size: 15px;
    margin-bottom: 4px;
  }
  .sym {
    font-family: var(--font-mono);
    color: var(--cardinal);
    margin-right: 4px;
  }
  .lever dd { margin: 0; }
  .src { font-size: 13px; color: var(--ink-3); }
  ul { margin: 0 0 10px; padding-left: 20px; list-style: disc; }
  ul li { margin-bottom: 4px; }
</style>
