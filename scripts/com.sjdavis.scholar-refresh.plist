<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sjdavis.scholar-refresh</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/stevedavis/.local/libexec/refresh-scholar-scheduled.sh</string>
  </array>
  <!-- Monthly: 10:00 on the 1st. If the laptop is asleep then, launchd
       runs the job at the next wake. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Day</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>10</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardErrorPath</key>
  <string>/Users/stevedavis/Library/Logs/scholar-refresh.launchd.log</string>
</dict>
</plist>
