---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScopeMatrix from '../components/ScopeMatrix.astro';
import featured from '../data/featured.json';
import publications from '../data/publications.json';
import tools from '../data/tools.json';
import type { FeaturedItem, Publication, Tool } from '../lib/types';
import { toolHref, toolsForPublication } from '../lib/tools';
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';

const items = (featured as FeaturedItem[])
  .slice()
  .sort((a, b) => (a.order ?? 999) - (b.order ?? 999));

// DOI lookup so a Featured row of type=publication with a `doi` cell can
// surface the paper's journal/year and link straight to it.
const pubsByDoi = new Map<string, Publication>();
for (const p of publications as Publication[]) {
  if (p.doi) pubsByDoi.set(p.doi.toLowerCase(), p);
}

function resolveImage(filename: string | null | undefined): string | null {
  if (!filename) return null;
  // Path-style values (e.g. "news/SSF.png") look up directly under /public/.
  if (filename.includes('/')) {
    if (existsSync(resolve('public', filename))) return `/${filename}`;
  }
  // Bare filenames search a few common folders.
  for (const folder of ['featured', 'news', 'images', 'images/news']) {
    if (existsSync(resolve('public', folder, filename))) return `/${folder}/${filename}`;
  }
  return null;
}

const cards = items.map((it) => {
  const pub = it.doi ? pubsByDoi.get(it.doi.trim().toLowerCase()) ?? null : null;
  // For type=publication with a known DOI, deep-link to the paper's card
  // anchor on /publications. A bare "/publications" override in the sheet
  // (the existing pattern) gets upgraded to the anchor automatically; a
  // distinct override URL is honored verbatim.
  const anchorLink = (it.type === 'publication' && it.doi)
    ? `/publications#pub-${it.doi.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`
    : null;
  const link =
    (anchorLink && (!it.link || it.link === '/publications'))
      ? anchorLink
      : (it.link || pub?.url || (it.doi ? `https://doi.org/${it.doi}` : null) || '#');
  // Companion efforts (Cornerstone and the like), resolved the same way the
  // publication cards do it: explicit slugs in the Publications tab's `tool`
  // column, plus any Tools-tab row whose own `doi` matches the paper.
  // Drop any that resolve to this card's own href: a type=tool card carrying
  // its paper's DOI otherwise lists itself as its own companion.
  const companions: Tool[] = (pub ? toolsForPublication(pub, tools as Tool[]) : [])
    .filter((t) => toolHref(t) !== link);
  return {
    ...it,
    imgUrl: resolveImage(it.image_filename),
    pub,
    companions,
    href: link,
    isExternal: typeof link === 'string' && /^https?:\/\//.test(link),
  };
});
---

<BaseLayout title="Sustainable Solutions Lab" showCoordReadout={true}>
  <section class="container-content pt-10 pb-6">
    <div class="flex flex-col md:flex-row md:items-stretch gap-8 md:gap-12">
      <div class="flex-1 min-w-0 flex flex-col gap-4">
        <p class="eyebrow mb-1">
          <span class="cardinal-dot"></span>STANFORD DOERR SCHOOL OF SUSTAINABILITY
        </p>
        <h1 class="display m-0">Underexamined questions.<br />Lasting answers.</h1>
        <p class="lede max-w-prose m-0">
          Our lab is dedicated to understanding the unavoidable environmental tradeoffs
          of energy, food, and material security, and to prioritizing the most
          sustainable solutions.
        </p>
      </div>
      <div class="md:flex-none w-full md:w-auto" style="max-width: 440px;">
        <ScopeMatrix />
      </div>
    </div>
  </section>

  <hr class="border-rule" />

  <section class="container-content pt-3 pb-2">
    <p class="eyebrow mb-1.5">FEATURED</p>

    {cards.length === 0 ? (
      <p class="text-ink-3 text-sm">
        Add rows to the <code>Featured</code> tab in the Google Sheet to populate this section.
      </p>
    ) : (
      <ul class="list-none p-0 m-0 grid md:grid-cols-3 gap-6 auto-rows-fr">
        {cards.map((it) => (
          <li class="m-0 p-0 h-full">
            {/* The card border/hover lives on this wrapper rather than the
                anchor so a companion-effort link can sit alongside the main
                link instead of nested inside it (nested <a> is invalid, and
                the stretched-link ::after trick would collide with the
                global a[data-external]::after arrow). */}
            <div
              class="group flex flex-col h-full bg-paper border border-rule border-b-0 hover:border-ink-3 transition-colors"
              style="border-radius: var(--radius-md); overflow: hidden;"
            >
            <a
              href={it.href}
              class="flex flex-col flex-1 bare"
              data-external={it.isExternal ? '' : null}
            >
              {it.imgUrl ? (
                <img
                  src={it.imgUrl}
                  alt={it.title}
                  loading="lazy"
                  class="block w-full object-cover shrink-0"
                  style="aspect-ratio: 16/10;"
                />
              ) : (
                <div
                  aria-hidden="true"
                  class="block w-full shrink-0"
                  style="aspect-ratio: 16/10; background: var(--paper-2); border-bottom: 1px solid var(--rule);"
                ></div>
              )}
              <div class="p-5 flex-1 flex flex-col">
                <p class="eyebrow m-0 mb-2">{(it.type ?? '').toString().toUpperCase()}</p>
                <h3 class="m-0">{it.title}</h3>
                {it.blurb && (
                  <p class="text-ink-2 text-sm mt-2 m-0" style="line-height: 1.5;">{it.blurb}</p>
                )}
                {it.pub && (
                  <p class="font-mono text-xs text-ink-3 mt-3 m-0 uppercase tracking-wider">
                    <em class="not-italic">{it.pub.journal}</em>
                    <span class="dot">·</span>
                    {it.pub.year}
                  </p>
                )}
              </div>
            </a>
            {it.companions.length > 0 && (
              <p class="font-mono text-xs text-ink-3 px-5 pb-5 m-0 uppercase tracking-wider">
                <span class="mr-1">Companion effort:</span>
                {it.companions.map((t, i) => (
                  <>
                    {i > 0 && <span class="dot">·</span>}
                    <a
                      href={toolHref(t)}
                      class="border-b-0 hover:underline"
                      data-external={/^https?:\/\//.test(toolHref(t)) ? '' : null}
                    >{t.title}</a>
                  </>
                ))}
              </p>
            )}
            </div>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
