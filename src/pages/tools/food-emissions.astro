---
import ToolFrame from '../../layouts/ToolFrame.astro';
import MapTool from '../../tools/_map/MapTool.jsx';
import tools from '../../data/tools.json';
import type { Tool } from '../../lib/types';

// Not yet in the tools sheet — page is reachable by URL but unlisted and
// noindex until the dataset/paper are public. Add a row to the tools sheet
// (slug: food-emissions) to list it, then drop `noindex`.
const tool = (tools as Tool[]).find((t) => t.slug === 'food-emissions') ?? null;

const repoLinks = {
  github: 'https://github.com/Sustainable-Solutions-Lab/gridded-land-sector-emissions',
};

// No author names until submission: the sidebar reads "in preparation"
// (Steve, 2026-10-20).
const companion = {
  title: 'Mapped drivers of food emissions',
  lead: null,
  journal: 'in preparation',
  year: 2026,
  url: null,
};
---

<ToolFrame
  title={tool?.title ?? 'Gridded land sector emissions'}
  description={tool?.summary ?? 'Commodity- and source-specific maps of greenhouse-gas emissions from land, compliant with the GHG Protocol Land Sector and Removals Standard (LSRS).'}
  noindex
  background="var(--paper-2)"
>
  <MapTool
    client:only="react"
    projectId="food-emissions"
    companion={companion}
    repoLinks={repoLinks}
    display={tool ? { title: tool.title, eyebrow: tool.eyebrow, summary: tool.summary } : null}
  />
</ToolFrame>
