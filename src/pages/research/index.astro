---
import BaseLayout from '../../layouts/BaseLayout.astro';
import publications from '../../data/publications.json';
import people from '../../data/people.json';
import researchData from '../../data/research.json';
import githubData from '../../data/github.json';
import type { Publication, Person } from '../../lib/types';
import { SYSTEMS, systemMatches } from '../../lib/systems';
import { totalCitations } from '../../lib/citations';

const pubs = publications as Publication[];
const peopleArr = people as Person[];

// Look up a Research-sheet row by slug, with soft-match fallback so a
// sheet slug like "impacts & adaptation" resolves to my code key "impacts"
// (first whitespace-separated token after normalization).
type ResearchRow = {
  slug: string;
  title?: string | null;
  summary?: string | null;
  hero_image?: string | null;
  narrative?: string | null;
};
const researchRows = researchData as ResearchRow[];
function findResearchRow(slug: string): ResearchRow | null {
  const norm = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
  const target = norm(slug);
  for (const r of researchRows) {
    if (norm(r.slug) === target) return r;
    if (norm(r.slug).split(' ')[0] === target) return r;
  }
  return null;
}

// ── Systems cards ────────────────────────────────────────────────────────────
const systemCards = SYSTEMS.map((s) => {
  const myPubs = pubs.filter((p) => systemMatches(p.system, s.slug));
  const cites = myPubs.reduce((sum, p) => sum + totalCitations(p), 0);
  return { ...s, count: myPubs.length, cites };
});

// ── Topics cards (matrix response axis) ──────────────────────────────────────
function responsePrefix(p: Publication, prefix: string): boolean {
  return (p.response ?? []).some((r) => r === prefix || r.startsWith(prefix + ':'));
}
const TOPICS = [
  {
    slug: 'mitigation',
    title: 'Mitigation',
    summary: 'Reducing greenhouse-gas emissions across systems — including the trade and carbon-management dimensions.',
    color:     'var(--spectral-10)',     // fill — top border, sub-area chip border
    textColor: 'var(--mitigation-text)', // AA text on paper
    subs: [
      { match: 'mitigation',                   label: 'General' },
      { match: 'mitigation:trade',             label: 'Trade' },
      { match: 'mitigation:carbon-management', label: 'Carbon mgmt' },
    ],
  },
  {
    slug: 'impacts',
    title: 'Impacts & adaptation',
    summary: 'Consequences of climate change for people and systems — air pollution, heat, drought, fire, flooding.',
    color:     'var(--spectral-2)',
    textColor: 'var(--impacts-text)',
    subs: [
      { match: 'impacts',               label: 'General' },
      { match: 'impacts:air-pollution', label: 'Air pollution' },
      { match: 'impacts:heat',          label: 'Heat' },
      { match: 'impacts:drought',       label: 'Drought' },
      { match: 'impacts:fire',          label: 'Fire' },
      { match: 'impacts:flooding',      label: 'Flooding' },
    ],
  },
];
const topicCards = TOPICS.map((t) => {
  const myPubs = pubs.filter((p) => responsePrefix(p, t.slug));
  const cites = myPubs.reduce((sum, p) => sum + totalCitations(p), 0);
  // Sheet override: Research tab summary wins when present.
  const overrideRow = findResearchRow(t.slug);
  const summary = overrideRow?.summary ?? t.summary;
  return { ...t, summary, count: myPubs.length, cites };
});

// ── Approach cards (Conceptual / Data-driven) ────────────────────────────────
// Tagged manually in the Publications sheet's `conceptual` column (TRUE/FALSE).
// Default false = data-driven.
const conceptualPubs = pubs.filter((p) => p.conceptual === true);
const dataDrivenPubs = pubs.filter((p) => p.conceptual !== true);
const conceptualCites = conceptualPubs.reduce((s, p) => s + totalCitations(p), 0);
const dataDrivenCites = dataDrivenPubs.reduce((s, p) => s + totalCitations(p), 0);
const ciuMembers = peopleArr.filter((p) => p.unit === 'ciu').length;
const NUM_WORDS = ['zero','one','two','three','four','five','six','seven','eight','nine','ten','eleven','twelve'];
const ciuMembersWord = ciuMembers <= 12 ? NUM_WORDS[ciuMembers] : String(ciuMembers);

// ── Open code & data (scripts/fetch-github.js snapshot) ─────────────────────
type GhRepo = {
  name: string; url: string; description: string; language: string | null;
  stars: number; pushedAt: string; commits52w: number[] | null;
};
type GhSnapshot = {
  orgUrl?: string; publicRepos?: number; totalStars?: number;
  featured: GhRepo[];
};
const gh = githubData as GhSnapshot;
const LANG_COLORS: Record<string, string> = {
  Python: '#3572A5', JavaScript: '#f1e05a', TypeScript: '#3178c6',
  R: '#198CE7', 'Jupyter Notebook': '#DA5B0B', Julia: '#a270ba',
};
// Joy-plot ridges: each repo's 52-week commit series as a filled ridge,
// Spectral-colored, drawn back-to-front with vertical overlap.
const JOY_W = 300;
const RIDGE_H = 30;   // amplitude of a full-scale week
const RIDGE_STEP = 15; // vertical offset between ridges (overlap = H - STEP)
const SPECTRAL = ['#5E4FA2', '#3288BD', '#66C2A5', '#FDAE61', '#D53E4F', '#9E0142'];
function ridgePath(counts: number[] | null, baseline: number): string | null {
  if (!counts || counts.length < 2) return null;
  const max = Math.max(...counts, 1);
  let d = `M 0 ${baseline.toFixed(1)}`;
  counts.forEach((c, i) => {
    const x = (i / (counts.length - 1)) * JOY_W;
    const y = baseline - (c / max) * RIDGE_H;
    d += ` L ${x.toFixed(1)} ${y.toFixed(1)}`;
  });
  d += ` L ${JOY_W} ${baseline.toFixed(1)} Z`;
  return d;
}
const joyRepos = gh.featured.filter((r) => r.commits52w && r.commits52w.some((c) => c > 0));
const joyH = RIDGE_H + RIDGE_STEP * Math.max(0, joyRepos.length - 1) + 6;

const conceptualOverride = findResearchRow('conceptual');
const dataDrivenOverride = findResearchRow('data-driven');
const approachCards = [
  {
    slug: 'conceptual',
    title: 'Conceptual',
    summary:
      conceptualOverride?.summary ??
      `Theory-first work by the lab's Conceptual Investigations Unit — ${ciuMembersWord} affiliated researcher${ciuMembers === 1 ? '' : 's'}, building abstract models in a quest for high-level insights into the behavior of important and complex systems.`,
    color: 'var(--cardinal)',
    href: '/research/conceptual',
    count: conceptualPubs.length,
    cites: conceptualCites,
    eyebrow: 'CONCEPTUAL · CIU',
  },
  {
    slug: 'data-driven',
    title: 'Data-driven',
    summary:
      dataDrivenOverride?.summary ??
      'Empirical and modeling work that quantifies emissions, impacts, and pathways across the systems and topics above.',
    color: 'var(--ink-2)',
    href: '/publications?approach=data-driven',
    count: dataDrivenPubs.length,
    cites: dataDrivenCites,
    eyebrow: 'DATA-DRIVEN',
  },
];
---

<BaseLayout title="Research" showCoordReadout={true}>
  <section class="container-content pt-8 pb-6">
    <div class="grid gap-8 items-start" style="grid-template-columns: minmax(0, 1fr);">
      <div>
        <p class="eyebrow mb-4">RESEARCH</p>
        <h1>What we study</h1>
        <p class="lede max-w-prose mt-4">
          The lab studies the unavoidable environmental tradeoffs of energy, food,
          and material security — and the most viable paths to a sustainable future.
          Our work spans six interconnected systems, two main topic axes, and two
          complementary methodological approaches.
        </p>
      </div>
      {joyRepos.length > 0 && (
        <aside
          class="bg-paper border border-rule p-4 code-panel"
          style="border-radius: var(--radius-md); max-width: 340px;"
        >
          <div class="flex items-baseline justify-between gap-2 mb-2">
            <p class="eyebrow m-0">OPEN CODE</p>
            <p class="font-mono text-xs text-ink-3 m-0">
              {gh.publicRepos} repos · ★ {gh.totalStars}
            </p>
          </div>
          {/* Ridgeline of the past year's commits, one Spectral ridge per repo,
              drawn back (top) to front (bottom). */}
          <svg
            viewBox={`0 0 ${JOY_W} ${joyH}`}
            style="width: 100%; height: auto; display: block;"
            aria-label="Weekly commit activity across the lab's most active repositories"
          >
            {joyRepos.map((r, i) => (
              <path
                d={ridgePath(r.commits52w, RIDGE_H + RIDGE_STEP * i + 3)}
                fill={SPECTRAL[i % SPECTRAL.length]}
                fill-opacity="0.9"
                stroke="var(--paper)"
                stroke-width="1"
              />
            ))}
          </svg>
          <ul class="list-none p-0 m-0 mt-2 grid grid-cols-2" style="gap: 1px 12px;">
            {joyRepos.map((r, i) => (
              <li class="m-0 p-0">
                <a
                  href={r.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-mono text-xs text-ink-2 hover:text-ink border-b-0 inline-flex items-center gap-1.5"
                  style="line-height: 1.7; max-width: 100%;"
                >
                  <span style={`width: 7px; height: 7px; border-radius: 2px; background: ${SPECTRAL[i % SPECTRAL.length]}; flex-shrink: 0;`} />
                  <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{r.name}</span>
                  {r.stars > 0 && <span class="text-ink-3" style="flex-shrink: 0;">★{r.stars}</span>}
                </a>
              </li>
            ))}
          </ul>
          <p class="font-mono text-xs m-0 mt-2 pt-2 border-t border-rule flex flex-wrap" style="gap: 2px 14px;">
            <a href={gh.orgUrl} target="_blank" rel="noopener noreferrer" class="text-ink-3 hover:text-ink border-b-0">GitHub ↗</a>
            <a href="https://zenodo.org/communities/sustainable-solutions-lab/" target="_blank" rel="noopener noreferrer" class="text-ink-3 hover:text-ink border-b-0">Zenodo ↗</a>
          </p>
        </aside>
      )}
    </div>
  </section>
  <style>
    @media (min-width: 900px) {
      .container-content > .grid.items-start {
        grid-template-columns: minmax(0, 1fr) minmax(280px, 340px) !important;
      }
    }
  </style>

  <section class="container-content pb-10">
    <h2 class="eyebrow mb-4">BY SYSTEM</h2>
    <ul class="grid md:grid-cols-2 lg:grid-cols-3 gap-4 list-none p-0 m-0">
      {systemCards.map((s) => (
        <li class="m-0 p-0 h-full">
          <a
            href={`/research/${s.slug}`}
            class="flex flex-col h-full bg-paper border border-rule hover:border-ink-3 transition-colors border-b-0"
            style={`border-radius: var(--radius-md); border-top: 4px solid ${s.color}; overflow: hidden;`}
          >
            <div class="p-5 flex-1 flex flex-col">
              <p class="eyebrow m-0 mb-2" style={`color: ${s.textColor};`}>SYSTEM</p>
              <h3 class="m-0">{s.title}</h3>
              <p class="text-ink-2 text-sm mt-2 m-0" style="line-height: 1.5;">
                {s.summary}
              </p>
              <p class="font-mono text-xs uppercase tracking-wider text-ink-3 mt-auto pt-4 m-0">
                <span class="text-ink-2">{s.count}</span> paper{s.count === 1 ? '' : 's'}
                <span class="dot">·</span>
                <span class="text-ink-2">{s.cites.toLocaleString()}</span> cite{s.cites === 1 ? '' : 's'}
              </p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <hr class="border-rule" />

  <section class="container-content pt-8 pb-10">
    <h2 class="eyebrow mb-4">BY TOPIC</h2>
    <ul class="grid md:grid-cols-2 gap-4 list-none p-0 m-0">
      {topicCards.map((t) => (
        <li class="m-0 p-0 h-full">
          <article
            class="flex flex-col h-full bg-paper border border-rule overflow-hidden"
            style={`border-radius: var(--radius-md); border-top: 4px solid ${t.color};`}
          >
            <div class="p-5 flex-1 flex flex-col">
              <p class="eyebrow m-0 mb-2" style={`color: ${t.textColor};`}>TOPIC</p>
              <h3 class="m-0">
                <a
                  href={`/publications?response=${encodeURIComponent(t.slug)}`}
                  class="border-b-0 hover:underline"
                >{t.title}</a>
              </h3>
              <p class="text-ink-2 text-sm mt-2 m-0" style="line-height: 1.5;">
                {t.summary}
              </p>
              <div class="flex flex-wrap gap-2 mt-3">
                {t.subs.map((sub) => (
                  <a
                    href={`/publications?response=${encodeURIComponent(sub.match)}`}
                    class="px-3 py-1.5 text-xs bg-paper-2 text-ink-2 hover:text-ink hover:bg-paper border border-rule border-b-0"
                    style={`border-radius: var(--radius-sm); border-left: 2px solid ${t.color};`}
                  >{sub.label}</a>
                ))}
              </div>
              <p class="font-mono text-xs uppercase tracking-wider text-ink-3 mt-auto pt-4 m-0">
                <span class="text-ink-2">{t.count}</span> paper{t.count === 1 ? '' : 's'}
                <span class="dot">·</span>
                <span class="text-ink-2">{t.cites.toLocaleString()}</span> cite{t.cites === 1 ? '' : 's'}
              </p>
            </div>
          </article>
        </li>
      ))}
    </ul>
  </section>

  <hr class="border-rule" />

  <section class="container-content pt-8 pb-24">
    <h2 class="eyebrow mb-4">BY APPROACH</h2>
    <ul class="grid md:grid-cols-2 gap-4 list-none p-0 m-0">
      {approachCards.map((a) => (
        <li class="m-0 p-0 h-full">
          <a
            href={a.href}
            class="flex flex-col h-full bg-paper border border-rule hover:border-ink-3 transition-colors border-b-0"
            style={`border-radius: var(--radius-md); border-top: 4px solid ${a.color}; overflow: hidden;`}
          >
            <div class="p-5 flex-1 flex flex-col">
              <p class="eyebrow m-0 mb-2" style={`color: ${a.color};`}>{a.eyebrow}</p>
              <h3 class="m-0">{a.title}</h3>
              <p class="text-ink-2 text-sm mt-2 m-0" style="line-height: 1.5;">
                {a.summary}
              </p>
              <p class="font-mono text-xs uppercase tracking-wider text-ink-3 mt-auto pt-4 m-0">
                <span class="text-ink-2">{a.count}</span> paper{a.count === 1 ? '' : 's'}
                <span class="dot">·</span>
                <span class="text-ink-2">{a.cites.toLocaleString()}</span> cite{a.cites === 1 ? '' : 's'}
              </p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

</BaseLayout>
