---
import BaseLayout from '../../layouts/BaseLayout.astro';
import src from '../../tools/contrails/gf-bookmarklet.js?raw';

// strip block comments and collapse whitespace so the javascript: URI stays small
const compact = src
  .replace(/\/\*[\s\S]*?\*\//g, '')
  .replace(/^\s*\/\/.*$/gm, '')
  .replace(/\n\s*/g, ' ')
  .trim();
const href = `javascript:${encodeURIComponent(compact)}`;
---

<BaseLayout
  title="Contrail check for Google Flights"
  description="A bookmarklet that scores every Google Flights result for predicted contrail warming."
  noindex
>
  <article class="mx-auto max-w-[680px] px-6 py-12">
    <p class="font-mono text-[11px] uppercase tracking-wider text-ink-3">
      Prototype · companion to the booking tool
    </p>
    <h1>Contrail check for Google Flights</h1>
    <p>
      Drag the button below to your bookmarks bar. Then, on any Google
      Flights results page, click it: every itinerary gets a colored badge
      with its predicted contrail warming in kg CO₂e per passenger, scored
      by the same schedule-only model as
      <a href="/tools/contrails">the booking tool</a>. Green means cleaner
      than most flights; deep red means it lands in the worst warming
      decile. Hover a badge for details.
    </p>
    <p class="my-8">
      <a
        href={href}
        class="rounded-sm border border-rule-strong bg-paper-3 px-4 py-2 font-bold no-underline"
        onclick="alert('Drag this to your bookmarks bar instead of clicking it here.'); return false;"
      >
        ☁ Contrail check
      </a>
    </p>
    <h2>Arc (and other browsers without a bookmarks bar)</h2>
    <p>
      Arc runs bookmarklets, but hides the classic bookmarks bar. Either
      pin any tab to your sidebar, then right-click it → Edit URL and
      paste the code below — clicking the pinned item runs the check on
      your active tab — or, for automatic badges on every search, create
      an Arc <em>Boost</em> on google.com/travel/flights and paste the
      same code as its custom JavaScript. (Pasting into the address bar
      directly won't work; Chromium strips the <code>javascript:</code>
      prefix there.)
    </p>
    <p>
      <button
        type="button"
        id="copy-bm"
        data-code={href}
        class="cursor-pointer rounded-sm border border-rule-strong bg-paper-3 px-4 py-2 font-bold"
      >
        Copy bookmarklet code
      </button>
    </p>
    <script>
      const btn = document.getElementById('copy-bm');
      btn?.addEventListener('click', async () => {
        await navigator.clipboard.writeText(btn.getAttribute('data-code') ?? '');
        btn.textContent = 'Copied';
        setTimeout(() => (btn.textContent = 'Copy bookmarklet code'), 1500);
      });
    </script>
    <h2>Notes</h2>
    <ul>
      <li>
        Connecting itineraries are scored leg by leg, with downstream
        departure times estimated from typical flight durations and the
        listed layovers.
      </li>
      <li>
        Google's results don't name the aircraft, so each leg assumes the
        most common type on its route (the tooltip says which). For a
        specific flight and aircraft, use the booking tool.
      </li>
      <li>
        If Google re-renders the list (new sort, new filters), click the
        bookmarklet again to refresh the badges.
      </li>
      <li>
        Predictions are climatological expectations from schedule
        information alone — not a weather forecast.
      </li>
    </ul>
  </article>
</BaseLayout>
