# Copy to `.env` and fill in. Never commit `.env` — it is gitignored.
#
# The sheet URLs are published-CSV links (Sheet > File > Share > Publish to
# web > pick the tab > CSV). They are readable by anyone who has them, since
# the data goes on a public site anyway; keeping them out of git just means
# we can rotate by republishing. Ask Steve for the current values.

# ── Required: the site does not build without these ──────────────────────
# scripts/fetch-sheets.js reads all six and fails loudly on a missing one,
# which is deliberate — a silently empty page is worse than a failed build.
SHEET_PUBLICATIONS_CSV=
SHEET_PEOPLE_CSV=
SHEET_NEWS_CSV=
SHEET_FEATURED_CSV=
SHEET_TOOLS_CSV=
SHEET_RESEARCH_CSV=

# ── Optional ─────────────────────────────────────────────────────────────
# Vercel deploy hook, used by the Apps Script that fires on a sheet edit.
# Only needed if you are working on that trigger.
VERCEL_DEPLOY_HOOK_URL=

# Publication summaries (scripts/summarize-publications.js). Only needed if
# you are regenerating them.
ANTHROPIC_API_KEY=

# Materials-explorer source data. Defaults point at the pmbusch/material-
# intensity clone in the shared paper Dropbox folder, so set these only if
# yours lives elsewhere. MATERIALS_REPO_DIR is the clone; the other three
# override individual folders (PROCESSED_DIR is the fallback for CSVs the
# public repo does not ship).
MATERIALS_REPO_DIR=
MATERIALS_PROCESSED_DIR=
MATERIALS_PARAMETERS_DIR=
MATERIALS_INPUTS_DIR=
