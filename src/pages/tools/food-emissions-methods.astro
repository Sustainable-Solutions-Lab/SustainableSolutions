---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Companion schematic for the food-emissions explorer: what the dataset
// outputs, which inputs set totals versus spatial pattern, and what is
// built, waiting on collaborators, or still aspirational.
//
// noindex matches the explorer itself — both go public when the dataset
// and paper do.
//
// LIVING DOCUMENT (Steve, 2026-10-05): the status flags, the status date in
// the footer, and the prose here and in the explorer's Methods panel must be
// updated WHENEVER the model state changes — a layer ships, a handoff lands,
// a method decision is taken. A stale "built/waiting/aspire" flag is worse
// than none, because this page is what collaborators will trust instead of
// reading the repo. The repo-side rule lives in Gridded LM docs/decisions.md.
//
// Status is carried by a left rail AND a text label, never colour alone,
// so it survives greyscale printing and colour-blind readers.

type Status = 'built' | 'progress' | 'wait' | 'aspire' | 'gap' | 'research';

const STATUS_LABEL: Record<Status, string> = {
  built: 'built', progress: 'in progress', wait: 'waiting', aspire: 'aspire', gap: 'gap', research: 'research only',
};

const totals: Array<{ n: string; d: string; s: Status; label?: string }> = [
  { n: 'FAOSTAT QCL', s: 'built', d: 'Crop production and area by country-year, 2000–2024' },
  { n: 'FAOSTAT GLE', s: 'built', d: 'Livestock Tier 1 national series, gas-native, 2000–2023' },
  { n: 'SPAM 2000 / 2005 / 2010 / 2020', s: 'built', d: 'Crop production and physical area, 42 crops' },
  { n: 'EDGAR', s: 'built', d: 'Envelope for liming CO₂' },
  { n: 'Jurisdictional land-use change (jdLUC)', s: 'wait', label: 'pending release', d: 'Land-use conversion — the whole of LSRS category 1. Pending final release.' },
  { n: 'Herrero-extension Tier 2 livestock', s: 'wait', d: 'Replaces the FAOSTAT envelope with gridded intensities. Same API.' },
];

const pattern: Array<{ n: string; d: string; s: Status }> = [
  { n: 'SPAM crop masks', s: 'built', d: 'Baseline allocation surface for all crops' },
  { n: 'Descals oil palm · Wang rubber · Song soy', s: 'built', d: 'Observed 10–30 m maps; palm and rubber carry planting year, so they double as conversion-cohort sources' },
  { n: 'FDaP cocoa & coffee', s: 'built', d: '2024 in hand; the 2018–2024 biennial series is re-exporting as threshold-then-aggregate cover, which fixes the partial-cover loss of the mean-probability form. Unreviewed and version-unstable, so a secondary layer.' },
  { n: 'Spatially explicit crop yields', s: 'progress', d: 'A crop-yield layer is being built in the lab; SPAM stands in for it until then. Per-kg factors already place national production by SPAM 2020’s modelled yields, which move an admin-1 factor by about −20% to +30% (10th to 90th percentile). The gain from a yield layer is over time: moving production and cropland within each country across SPAM’s 2000–2020 maps shifts about 0.7 Gt of the global land-per-calorie gain in the 2000–2023 decomposition, most strongly in Indonesia. Crop-residue grids already follow SPAM yields; their change over time does not yet. Not in any total; next is an annual area basis, then the lab’s layer in place of SPAM.' },
  { n: 'MapBiomas Brazil', s: 'built', d: '30 m annual, national detail where it matters most' },
  { n: 'Global Pasture Watch · GLW livestock shares', s: 'built', d: 'Grazing animals follow Global Pasture Watch’s annual 1 km maps, 2000–2022 (buffalo on its cattle pattern); pigs and poultry follow GLW 2010 / 2015 / 2020, interpolated between editions. Both are census downscalings: pattern is modelled, not observed.' },
  { n: 'Trase · Kalischek cocoa shares', s: 'built', d: 'Ghana and Côte d’Ivoire cocoa follows Kalischek et al. (2023) district totals via Trase, with FDaP as the within-district weight. Ghana’s national cocoa area follows Kalischek (2.71 Mha) rather than FAOSTAT (1.49).' },
];

const cat2: Array<{ n: string; d: string; s: Status }> = [
  { n: 'Cropland soil carbon', s: 'built', d: 'On the map: the IPCC Tier 2 management term, a net sink of +14.9 Tg C/yr; losing cells (about 9 Mt CO₂e/yr) count, gaining cells are not credited. Observation-side products put the net at or below zero (Sanderman −15.0, OpenLandMap −41.5), and LUCAS re-measurements are near neutral with 45% of points losing.' },
  { n: 'Cropland legacy decay', s: 'research', d: 'Not planned for the dataset. A Sanderman legacy-decay term (−15.0 Tg C/yr) would cancel the Tier 2 sink globally and flip 96% of gain cells, but across 15 LUCAS countries observed change follows the management term (r = 0.51), not the legacy term (r = −0.05).' },
  { n: 'Peatland', s: 'built', d: 'Two-part model: a pulse at drainage (land-use change), then a steady occupation flux at IPCC Tier 1 rates by land use and climate zone, all gases, perpetual while drained: 951 Mt CO₂e/yr on 21.5 Mha. Malaysia, empty in the upstream drained-peat map, is patched from PEATMAP extent × crop maps (1.5 Mha of crops on peat, ~73 Mt CO₂e/yr).' },
  { n: 'Peat split by land use', s: 'built', d: 'Now the main peat term. The single 37.3 t CO₂e/ha/yr rate used before is IPCC’s temperate cropland value to 0.2%; in the tropics IPCC runs 34% higher (oil palm 45, tree crops 60, other cropland 58), and its tropical factors come from sites drained more than six years, so they pair with the drainage pulse without double counting. The single rate stays on the map as a comparison view (802 Mt CO₂e/yr). To be discussed with the land-use-change lead.' },
  { n: 'Peat as an exhaustible stock', s: 'progress', d: 'Drained peat is a finite carbon stock, so its emissions should stop when it runs out. Built as a test with the PEATGRIDS v2.0.1 global peat carbon-stock map (Widyastuti et al.), keeping the spread of its 1 km pixels within each cell: median 1,400 t C/ha under drained cropland. Where peat runs out the land is still cropland, so it moves to the cropland soil carbon method used everywhere else on the map (IPCC Tier 2), starting from the IPCC reference stock for wet mineral soils; that part adds under 2 Mt CO₂e/yr in 2020. For 2020 this lowers cropland peat by 0 to 4% (951 to 911 Mt CO₂e/yr), depending on whether the map shows peat as it is today or before drainage; the tropics move under 1%. By 2120, 6 to 38% of drained hectares have run out. It replaces the steady rate in the totals once three things are settled: which reading of the map holds in each country, a check of the map against measured depths on drained farmland, and the year each area was drained.' },
  { n: 'Drainage pulse checked against peat depth', s: 'progress', d: 'The land-use-change charge for first drainage is 621 t CO₂e/ha (about 169 t C) on every conversion on peat, 8.0 Mha in 2001–2020. Depth never limits it where peat is mapped: the shallowest cell holds 181 t C/ha. Two larger questions came out instead, now with the land-use-change lead: about a quarter of those hectares are not peat on the Global Peatland Map 2.0, more than half of them in Canada, and about a third are pasture converted to cropland, on peat already drained as pasture.' },
  { n: 'Drained peat area checked against national inventories', s: 'progress', label: 'under review', d: 'Our drained cropland peat matches what Annex I countries report to the UNFCCC for most of them (Germany 0.34 vs 0.33 Mha, United States 0.82 vs 0.71, Belarus 1.17 vs 1.00). Canada is the exception: the upstream map has 1.07 Mha, mostly wheat, canola and barley, about 40 Mt CO₂e/yr, against 0.016 Mha of cultivated organic soil in Canada’s inventory. The methods differ: Canada reports the same fixed area every year since 1990, while our map and FAO’s own estimate (1.22 Mha) overlay soil maps on cropland and assume all of it is drained, as most other inventories do. Only about half of our Canadian hectares are peat on the PEATGRIDS map, mostly on the northern edge of the prairies. Russia runs low (1.46 vs 2.50). A fix is being decided.' },
  { n: 'Rangeland soil carbon', s: 'built', d: 'Preliminary, on the map. The Ren et al. (2024) grazing response, refit on 78 of its 84 covariates (all but elevation from the authors’ own layers), is primary: about 2.3 Gt CO₂e cumulative 2000–2022. Powell et al. (2026) is a cross-check on well-conditioned cells. Still open: the present-day grazing-intensity level, where the other global product gives 2.7 Gt. Refitting on every layer the authors supplied does not close that gap, so it is the grazing-intensity map, not the covariates. A scope control lets readers choose which grazing land counts under the LSRS: all of it, cultivated grassland only, or natural grassland too above a grazing-intensity threshold. The herd time axis follows FAOSTAT stocks: a seam in the 2010 livestock grid had given South Sudan the whole former-Sudan herd.' },
  { n: 'Forest soil carbon', s: 'built', d: 'On the map, not in any total. Mineral forest soil is held at the IPCC default of steady state, which national inventories support: Annex I parties report a net gain of +0.03 t C/ha/yr across 1,665 Mha. The drained organic soil that had fallen between the peat and forest layers is now its own layer: CO₂, CH₄ and N₂O as 22 Annex I parties report them (38 Mt CO₂e/yr on 10.4 Mha in 2020), placed on forest over PEATMAP peat.' },
  { n: 'Tropical drained forest peat', s: 'built', d: 'Non-Annex I parties report no drained forest area, so Sumatra, Borneo and Peninsular Malaysia use IPCC Tier 1 (2013 Wetlands Supplement) on 2015 areas of degraded peat-swamp forest, secondary forest and acacia pulpwood from Miettinen et al. (2017), placed with the Lesiv et al. (2022) forest-management map: about 170 Mt CO₂e/yr on 6.2 Mha, about half of it from acacia. On the map, not in any total. Papua and other tropical peat, largely undrained, are not included.' },
  { n: 'Forest soil allocation', s: 'built', d: 'Forest land is no food commodity’s land, so the forest soil layer is split by who would own it under the GHG Protocol Land Sector and Removals Standard, as three map views. Wood products, v1 rule: CH₄ and N₂O from drained peat under wood-producing forest (Annex I managed forest and acacia pulpwood), about 11 Mt CO₂e/yr, which v1 counts as production emissions of the timber, pulp and paper sourced. Wood products, allocation pending: the CO₂ from the same forest, about 116 Mt, which v1 does not cover because the Independent Standards Board has not yet decided forest carbon accounting (request for information due 2026). No product: degraded peat-swamp forest and secondary forest in Southeast Asia, about 83 Mt, which no LSRS rule assigns to any product.' },
  { n: 'Forest soil re-measurement', s: 'aspire', d: 'ICP Forests BioSoil, Germany’s BZE I–III and the Nordic forest soil inventories: the forest analogue of LUCAS, and the only direct test of the steady-state default.' },
];

const forest = [
  ['Plot pilots — US FIA, France IGN, Spain IFN', 'Both accounting options from ~334,000 re-measurements', '—', 'built'],
  ['Mexico INFyS', 'First tropical anchor with coordinates, 26k plot pairs', '1.85×', 'built'],
  ['GFW / Harris flux', 'The managed-land proxy computed globally', '~2× high', 'validated'],
  ['UNFCCC CRF, Annex I', 'Pool-matched national inventories', '~2×', 'built'],
  ['GEDI lidar', 'Emission factors, independent of inventories', '1.29–1.40', 'built'],
  ['Germany BWI', 'Counterfactual baselines outside FIA', '—', 'aspire · access unresolved'],
];

const cat3 = ['Fertilizer', 'Manure applied', 'Manure mgmt', 'Pasture N₂O', 'Residues',
  'Residue burning', 'Rice CH₄', 'Enteric CH₄', 'Urea CO₂', 'Liming CO₂'];
---

<BaseLayout
  title="What we are building"
  description="Schematic of the gridded land-sector emissions dataset: what it outputs, which raw data sets totals versus spatial pattern, and what is built, waiting, or aspired to."
  noindex
>
  <main class="relative mx-auto w-full max-w-[1180px] px-4 py-10 md:py-14">
    <a href="/tools/food-emissions" class="close-schematic" data-close-schematic
      aria-label="Close the schematic and return to the explorer" title="Close">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
        <line x1="6" y1="6" x2="18" y2="18" /><line x1="18" y1="6" x2="6" y2="18" />
      </svg>
      <span>Close</span>
    </a>
    <p class="eyebrow">Gridded land-sector emissions · schematic</p>
    <h1 class="font-serif text-[clamp(28px,4.4vw,41px)] leading-[1.12] font-semibold mb-3 text-balance">
      What we are building, and what it rests on
    </h1>
    <p class="text-ink-2 max-w-[66ch] text-base">
      A global grid of greenhouse-gas emissions by source and commodity, built to the
      GHG Protocol Land Sector and Removals Standard. The architecture has one
      organising idea: <strong>national totals and spatial pattern come from different
      places</strong>, and almost every question about trust resolves to which of the
      two a given dataset is carrying.
    </p>

    <!-- legend -->
    <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2 rounded border border-rule bg-paper-2 px-4 py-3.5">
      <span class="lg"><i class="sw built"></i>Built and running</span>
      <span class="lg"><i class="sw progress"></i>In progress — built and tested, not yet in totals</span>
      <span class="lg"><i class="sw wait"></i>Waiting on others</span>
      <span class="lg"><i class="sw aspire"></i>Aspire / planned</span>
      <span class="lg"><i class="sw gap"></i>Known gap — counted nowhere</span>
      <span class="lg"><i class="sw research"></i>Research only — not planned</span>
    </div>

    <!-- inputs -->
    <section class="band">
      <h2>Raw data, by the job it does</h2>
      <p class="sub">The same dataset can be excellent for one job and unusable for the
      other. Sorting inputs this way is what makes the trust question answerable.</p>
      <div class="grid gap-6 md:grid-cols-2">
        <div class="role">
          <h3>Sets the magnitude <span class="tag tag-t">totals</span></h3>
          <p class="why">National or sub-national statistics. These fix how much is
          emitted. They are census-grade and change year to year.</p>
          {totals.map((c) => (
            <div class={`card ${c.s}`}>
              <div class="n"><span>{c.n}</span><span class={`st ${c.s}`}>{c.label ?? STATUS_LABEL[c.s]}</span></div>
              <div class="d">{c.d}</div>
            </div>
          ))}
        </div>
        <div class="role">
          <h3>Sets the pattern <span class="tag tag-p">within-country</span></h3>
          <p class="why">Maps that say <em>where inside a country</em> the total goes.
          Their absolute values never reach the output — only their relative weights.</p>
          {pattern.map((c) => (
            <div class={`card ${c.s}`}>
              <div class="n"><span>{c.n}</span><span class={`st ${c.s}`}>{STATUS_LABEL[c.s]}</span></div>
              <div class="d">{c.d}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- the spine -->
    <section class="band">
      <h2>The allocation rule</h2>
      <p class="sub">Every cropland and livestock source in the dataset is produced this
      way. It is the reason a mask can be imperfect without corrupting a total.</p>
      <div class="rounded border border-rule-strong bg-paper-3 p-5">
        <p class="my-3 overflow-x-auto whitespace-nowrap text-center font-mono text-[clamp(10px,1.35vw,14px)] leading-[2.1]">
          cell emissions&nbsp;=&nbsp;<b class="eq eq-t">national total</b>&nbsp;×&nbsp;<b class="eq eq-p">cell&rsquo;s share of the country&rsquo;s mask</b>
        </p>
        <p class="note"><strong>What this buys.</strong> National numbers are exact by
        construction — they are the statistics themselves. A mask that misplaces crop
        within a country moves emissions between cells but never changes the country&rsquo;s
        total, so mask error is bounded and local.</p>
        <p class="note"><strong>What it costs.</strong> Sub-national accuracy is only as
        good as the mask, and nothing in the pipeline checks it. That is exactly where
        the Trase cocoa constraint now bites for Ghana and C&ocirc;te d&rsquo;Ivoire, and why the modelled livestock pattern matters
        far more for grazing intensity than it ever did for emissions.</p>
      </div>
    </section>

    <!-- outputs -->
    <section class="band">
      <h2>What comes out</h2>
      <p class="sub">Emissions on a 5-arcminute global grid, resolved by source,
      commodity, jurisdiction and year, grouped by LSRS accounting category.</p>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <div class="out">
          <h3>Category 1 <span class="st wait">pending release</span></h3>
          <div class="p-3.5 text-[12.5px] text-ink-3">Land-use conversion. Pending
          final release.</div>
        </div>
        <div class="out">
          <h3>Category 2 <span class="st built">partly built</span></h3>
          <div class="p-3.5">
            <p class="mb-2 text-[12.5px] text-ink-3">Land-management net biogenic CO₂.</p>
            <div class="chips">
              <span class="chip">Peatland</span><span class="chip">Soil carbon — cropland</span>
              <span class="chip">Soil carbon — rangeland</span>
              <span class="chip">Soil carbon — forest</span>
              <span class="chip off">Forest carbon (pilot)</span>
            </div>
          </div>
        </div>
        <div class="out">
          <h3>Category 3 <span class="st built">built</span></h3>
          <div class="p-3.5">
            <p class="mb-2 text-[12.5px] text-ink-3">Land-management production — the complete set.</p>
            <div class="chips">{cat3.map((c) => <span class="chip">{c}</span>)}</div>
          </div>
        </div>
      </div>
      <p class="my-3.5 text-center font-mono text-[11px] tracking-[0.08em] text-ink-4">↓ delivered as ↓</p>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <div class="card built"><div class="n"><span>Public explorer</span><span class="st built">private beta</span></div>
          <div class="d">Gridded (0.25°, and the native 5′ grid when zoomed in) and regional views, per-km² intensity, compare mode, bulk download</div></div>
        <div class="card built"><div class="n"><span>Emission-factor download</span><span class="st built">live</span></div>
          <div class="d">Admin-1 and country × commodity × source, kg CO₂e per kg, 2024, from the explorer. Average and residual land-use-change factors and the claimed share join when land-use change is released.</div></div>
        <div class="card built"><div class="n"><span>Peer-reviewed paper</span><span class="st built">in prep</span></div>
          <div class="d">Mapped drivers of food emissions</div></div>
      </div>
    </section>

    <!-- cat 2 detail -->
    <section class="band">
      <h2>Category 2 in detail</h2>
      <p class="sub">The least finished part of the dataset, and the one where the method
      is still being decided rather than merely implemented.</p>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {cat2.map((c) => (
          <div class={`card ${c.s}`}>
            <div class="n"><span>{c.n}</span><span class={`st ${c.s}`}>{STATUS_LABEL[c.s]}</span></div>
            <div class="d">{c.d}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- forest -->
    <section class="band">
      <h2>Forest carbon runs on its own track</h2>
      <p class="sub">Two accounting options under the Standard, computed in parallel so
      they can be compared: the managed-land proxy and an activity-based estimate. Shown
      in the explorer as a research preview, counted in no total.</p>
      <div class="overflow-x-auto">
        <table>
          <thead><tr><th>Reference</th><th>What it tests</th><th>Result</th><th>Status</th></tr></thead>
          <tbody>
            {forest.map(([a, b, c, d]) => (
              <tr><td>{a}</td><td>{b}</td><td class="tabular-nums whitespace-nowrap">{c}</td><td>{d}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note ml-0">The verdict that shapes everything downstream: GFW&rsquo;s
      <em>emissions</em> hold up, its <em>removals</em> run about twice measured, and its
      per-cell values vary roughly eight times less than reality — so it can carry a
      total but not a map.</p>
    </section>

    <p class="mt-11 border-t border-rule pt-4 text-[12px] text-ink-3">
      Companion to the <a href="/tools/food-emissions">food-emissions explorer</a> and to
      a companion paper in preparation. <strong>Status as of 21 October 2026.</strong>
      This page and the explorer's Methods describe a model under active development;
      both are maintained to reflect its current state.
    </p>
  </main>
</BaseLayout>

<script is:inline>
  // Close returns to the explorer. When the reader came from it, go back
  // in history so the map keeps its view and the Methods panel state;
  // otherwise (a shared link) the href opens the explorer fresh.
  (function () {
    var a = document.querySelector('[data-close-schematic]');
    if (!a) return;
    a.addEventListener('click', function (e) {
      try {
        var r = document.referrer && new URL(document.referrer);
        if (r && r.origin === location.origin && r.pathname.indexOf('/tools/food-emissions') === 0
            && r.pathname.indexOf('/tools/food-emissions-methods') !== 0 && history.length > 1) {
          e.preventDefault();
          history.back();
        }
      } catch (_) {}
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') a.click();
    });
  })();
</script>

<style>
  .close-schematic { position: absolute; top: 1.25rem; right: 1rem; display: inline-flex;
    align-items: center; gap: 6px; padding: 6px 8px; border-radius: var(--radius-sm, 4px);
    font-family: 'Inter', system-ui, sans-serif; font-size: 12px; letter-spacing: .08em;
    text-transform: uppercase; color: var(--ink-3); border-bottom: 0; text-decoration: none; }
  .close-schematic:hover { color: var(--ink); background: var(--paper-2); }
  @media (min-width: 768px) { .close-schematic { top: 2rem; } }
  .eyebrow { font-family: 'Inter', system-ui, sans-serif; font-size: 11px;
    letter-spacing: .16em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 8px; }
  .lg { display: flex; align-items: center; gap: 8px; font-size: 12.5px; color: var(--ink-2); }
  .sw { width: 22px; border-top-width: 3px; flex: none; border-radius: 2px; }
  .sw.built { border-top-style: solid; border-top-color: var(--brand-green); }
  .sw.progress { border-top-style: dotted; border-top-color: var(--brand-green); }
  .sw.wait { border-top-style: dashed; border-top-color: var(--brand-orange); }
  .sw.aspire { border-top-style: dotted; border-top-color: var(--ink-3); }
  .sw.gap { border-top-style: solid; border-top-color: var(--cardinal); }
  .sw.research { border-top-style: solid; border-top-width: 1px; border-top-color: var(--ink-3); }

  .band { margin-top: 40px; }
  .band > h2 { font-family: var(--font-serif, 'Source Serif 4', Georgia, serif);
    font-size: 23px; font-weight: 600; margin-bottom: 4px; }
  .band > .sub { color: var(--ink-3); font-size: 13px; margin-bottom: 16px; max-width: 70ch; }

  .role { border: 1px solid var(--rule); border-radius: 4px; padding: 16px;
    background: var(--paper-2); min-width: 0; }
  .role h3 { font-size: 14px; font-weight: 600; display: flex; align-items: baseline;
    gap: 8px; flex-wrap: wrap; margin-bottom: 2px; }
  .role .why { color: var(--ink-3); font-size: 12.5px; margin: 4px 0 12px; }
  .tag { font-family: 'Inter', system-ui, sans-serif; font-size: 10px;
    letter-spacing: .1em; text-transform: uppercase; padding: 2px 7px; border-radius: 3px; }
  .tag-t { color: #3288BD; border: 1px solid #3288BD; }
  .tag-p { color: #9E0142; border: 1px solid #9E0142; }
  :global([data-theme='dark']) .tag-t { color: #6FB3DC; border-color: #6FB3DC; }
  :global([data-theme='dark']) .tag-p { color: #D4607F; border-color: #D4607F; }

  .card { border: 1px solid var(--rule); border-left-width: 3px; border-left-style: solid;
    border-radius: 3px; padding: 9px 11px; background: var(--paper); margin-bottom: 7px; }
  .card:last-child { margin-bottom: 0; }
  .card.built { border-left-color: var(--brand-green); }
  .card.progress { border-left-color: var(--brand-green); border-left-style: dotted; }
  .card.wait { border-left-color: var(--brand-orange); border-left-style: dashed; }
  .card.aspire { border-left-color: var(--ink-3); border-left-style: dotted; }
  .card.gap { border-left-color: var(--cardinal); }
  .card.research { border-left-color: var(--rule); }
  .card .n { font-weight: 600; font-size: 13px; display: flex; gap: 10px;
    justify-content: space-between; align-items: baseline; }
  .card .d { color: var(--ink-3); font-size: 12px; margin-top: 2px; }
  .st { font-family: 'Inter', system-ui, sans-serif; font-size: 9.5px;
    letter-spacing: .09em; text-transform: uppercase; flex: none; }
  .st.built { color: var(--brand-green); } .st.progress { color: var(--brand-green); } .st.wait { color: var(--brand-orange); }
