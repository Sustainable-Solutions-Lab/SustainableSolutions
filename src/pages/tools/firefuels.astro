---
import ToolFrame from '../../layouts/ToolFrame.astro';
import MapTool from '../../tools/firemap/MapTool.jsx';
import tools from '../../data/tools.json';
import type { Tool } from '../../lib/types';

const tool = (tools as Tool[]).find((t) => t.slug === 'firefuels') ?? null;

// Hand-pin the firefuels companion paper. The Tools-sheet doi lookup was
// brittle (one Sheet edit could quietly drop the sidebar card), so we just
// pin the preprint metadata here. If/when the paper is officially
// published, swap the URL + journal + year and the card updates everywhere
// the firefuels tool is loaded.
const companion = {
  title: 'Prioritizing wildfire fuel management in California',
  journal: 'in review',
  year: 2025,
  url: 'https://eartharxiv.org/repository/view/9858/',
};
---

<ToolFrame title={tool?.title ?? 'Firefuels'} description={tool?.summary} background="var(--paper-2)">
      <MapTool
        client:only="react"
        companion={companion}
        display={tool ? { title: tool.title, eyebrow: tool.eyebrow, summary: tool.summary } : null}
      />
</ToolFrame>

